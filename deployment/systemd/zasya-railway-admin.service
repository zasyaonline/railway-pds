[Unit]
Description=Zasya Railway Admin
PartOf=zasya-railway.target
After=zasya-railway-platform.service zasya-railway-coach.service

[Service]
Type=simple
User=zasya-admin
Group=zasya
WorkingDirectory=/opt/zasya/railway
SupplementaryGroups=audio
Environment=RAILWAY_APPLIANCE=1
Environment=ADMIN_PORT=3002
Environment=BIND_HOST=127.0.0.1
Environment=ZASYA_PIPER_BIN=/opt/zasya/piper/piper
Environment=ZASYA_PIPER_MODELS=/var/lib/zasya/railway/tts/models
Environment=LD_LIBRARY_PATH=/opt/zasya/piper
ExecStart=/usr/bin/node /opt/zasya/railway/edge/admin/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=zasya-railway.target

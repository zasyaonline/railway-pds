{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coach-position.zasya.online/schemas/coach_displays.schema.json",
  "title": "CoachDisplaysConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["stationCode", "displays"],
  "properties": {
    "stationCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 6,
      "pattern": "^[A-Z0-9]+$"
    },
    "bogieLengthMeters": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 25
    },
    "showBeforeMinutes": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "hideAfterDepartMinutes": {
      "type": "integer",
      "minimum": 0,
      "default": 15
    },
    "languages": {
      "type": "array",
      "items": { "type": "string", "enum": ["en", "te", "hi"] },
      "minItems": 1,
      "default": ["en", "te", "hi"]
    },
    "displays": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/display" }
    }
  },
  "$defs": {
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "platformsShown"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["dual", "single"] },
        "platformsShown": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "youAreHere": { "$ref": "#/$defs/youAreHere" }
      }
    },
    "youAreHere": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "facing"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "metersFromEngineEnd": { "type": "number", "minimum": 0 },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based coach index; overrides metres when set"
        },
        "facing": {
          "type": "string",
          "enum": ["engine_left", "engine_right"]
        }
      },
      "anyOf": [
        { "required": ["metersFromEngineEnd"] },
        { "required": ["slotIndex"] }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coach-position.zasya.online/schemas/station_layout.schema.json",
  "title": "StationLayout",
  "description": "Optional per-station geometry notes for coach-position displays",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "platforms"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 6
    },
    "name": { "type": "string" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "islandWith": {
            "type": ["string", "null"],
            "description": "Other face id if island platform"
          },
          "engineStopNote": {
            "type": "string",
            "description": "Ops note for where engine typically stops"
          },
          "lengthMeters": { "type": ["number", "null"] }
        }
      }
    },
    "notes": { "type": "string" }
  }
}

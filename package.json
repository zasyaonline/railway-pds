{
  "name": "railway-pds",
  "version": "1.0.0",
  "description": "Charlapalli Railway Station Passenger Display System POC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:ntes": "node edge/ntes/poller.js",
    "start:admin": "node edge/admin/server.js",
    "start:platform": "node server.js",
    "start:coach": "node coach-position/server.js",
